# DO NOT EDIT: http://go/vendor-skycfg
SUPPORTED_AVAILABILITY_ZONES = [
    "us-east-1a",
    "us-east-1d",
    "us-east-1e",
    "us-east-2a",
    "us-east-2b",
    "us-east-2c",
    "ap-south-1a",
    "ap-south-1b",
    "ap-south-1c",
    "us-west-2a",
    "us-west-2b",
    "us-west-2c"
]

STRIPE_CLUSTER_TO_AWS_REGION = {
    "northwest": "us-west-2",
    "cmh": "us-east-2",
    "east": "us-east-1",
    "bom": "ap-south-1"
}

def aws_az_valid(az, cluster):
    if az not in SUPPORTED_AVAILABILITY_ZONES:
        return False, "unsupported availability zone"

    if not cluster:
        return True, "" # skip

    if cluster not in STRIPE_CLUSTER_TO_AWS_REGION.keys():
        return False, "unknown stripe cluster: %s" % cluster

    aws_region = STRIPE_CLUSTER_TO_AWS_REGION[cluster]
    if not az.startswith(aws_region):
        return False, "specified AZ %s does not match with the current cluster's AWS region of %s" % (az, aws_region)

    return True, ""
