# DO NOT EDIT: http://go/vendor-skycfg
HORIZON_MEMORY_USAGE = '''
(
    max by (role,host_cluster) (
        avg_over_time(
            jvm_memory_usage_bytes{{
                role="{role}",
                henson_service="{henson_service_name}",
                host_cluster="{host_cluster}",
                deploy_color="{deploy_color}"{server_priority_tier}{service_name}
            }}[1m]
        )
    )
    /
    max by (role,host_cluster) (
        avg_over_time(
            jvm_memory_max_bytes{{
                role="{role}",
                henson_service="{henson_service_name}",
                host_cluster="{host_cluster}",
                deploy_color="{deploy_color}"{server_priority_tier}{service_name}
            }}[1m]
        )
    )
) * 100
'''

WORKFLOW_TASKS_SLOTS_QUERY = '''
max(
    {activity_task_slots_per_worker} - avg(
        workflow_engine_worker_task_slots_available{{execution_type="activity", task_queue="{env}_{repo}_{workflow_engine_task_queue_project}", workflow_namespace="{workflow_engine_namespace}", host_cluster="{host_cluster}"}}
    )
)
'''

WORKFLOW_TASK_SLOTS_QUERY_WITH_UTILIZATION = '''
max(
    (
        {activity_task_slots_per_worker} - avg(
            workflow_engine_worker_task_slots_available{{execution_type="activity", task_queue="{env}_{repo}_{workflow_engine_task_queue_project}", workflow_namespace="{workflow_engine_namespace}", host_cluster="{host_cluster}"}}
        )
    )
    /
    {activity_task_slots_per_worker}
) * 100
'''

WORKFLOW_WORKER_ACTIVE_QUERY = '''
sum(
    avg_over_time(
        faas_srv_worker_active{{workflow_task_queue="{env}_{repo}_{workflow_engine_task_queue_project}", workflow_namespace="{workflow_engine_namespace}", host_cluster="{host_cluster}"}}[1m]
    )
)
'''

RUBY_WORKER_UTILIZATION = '''
100 - min (
  max_over_time(
    avg (
      sys_workers_availability_percent{{
        henson_service="{henson_service_name}",
        host_cluster="{host_cluster}",
        deploy_color="{deploy_color}"{service_name}
    }})[20s:10s]
  )
) * 100
'''

HORIZON_OP_UTILIZATION = '''
avg (
  max_over_time(
    grpc_server_request_active_op_count{{
        role="{role}",
        pool_name!="admin",
        henson_service="{henson_service_name}",
        host_cluster="{host_cluster}",
        deploy_color="{deploy_color}"{server_priority_tier}{service_name}
    }}[1m])
    /
  max_over_time(
    grpc_server_request_pool_max{{
        role="{role}",
        pool_name!="admin",
        henson_service="{henson_service_name}",
        host_cluster="{host_cluster}",
        deploy_color="{deploy_color}"{server_priority_tier}{service_name}
    }}[1m])
) * 100
'''
