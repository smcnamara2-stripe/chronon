# DO NOT EDIT: http://go/vendor-skycfg
load("config/kubernetes/core/container.sky", "sidecar_container")
load("config/kubernetes/core/volume.sky", "volume_mount")
load("config/kubernetes/plugins/compose.sky", "compose_plugins")
load("config/kubernetes/sidecars/variables.sky", "CHROMIUM_CONTAINER_FALLBACK_DIGEST", "CHROMIUM_CONTAINER_FALLBACK_ENV")

def chromium_sidecar(ctx):
    chromium_container_name = "chromium"
    chromium_container_image = "stripe/pay-server/chromium-container"
    chromium_fallback_digest = CHROMIUM_CONTAINER_FALLBACK_DIGEST
    chromium_fallback_env = CHROMIUM_CONTAINER_FALLBACK_ENV

    return compose_plugins(
        sidecar_container(
            name = chromium_container_name,
            command = [
                "/usr/local/bin/chromium-wrapper.sh",
                "--headless",
                "--disable-dev-shm-usage",
                # Enable Chrome's fallback software renderer to allow websites to construct required request headers
                # using webgl/canvas elements. These elements require a GPU to function.
                "--use-gl=angle",
                "--use-angle=swiftshader-webgl",
                # setup CDP websocket listener
                "--remote-debugging-address=0.0.0.0",
                "--remote-debugging-port=9222",
                # disable IP leak via webRTC
                "--webrtc-ip-handling-policy=disable_non_proxied_udp",
                "--force-webrtc-ip-handling-policy",
                # disable blink's (open source rendering engine) tags that tell the browser that this chromium instance is being
                # automatically controlled. The corrects browser properties such as window.navigator.webdriver
                "--disable-blink-features=AutomationControlled",
                # In order to use the GPU, this flag should be included as instructed by chrome logs
                "--enable-unsafe-swiftshader",
                # Disable autofill server communication to prevent the browser from sending crowdsourced autofill data to Google
                # and triggering unwanted egress denials
                # https://source.chromium.org/chromium/chromium/src/+/main:components/autofill/core/common/autofill_features.cc
                "--disable-features=AutofillServerCommunication",
                # Set a default user agent that doesn't contain HeadlessChrome so that when new pages open we are less identifiable as a bot
                "--user-agent='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36'",
            ],
            container_image = chromium_container_image,
            fallback_label = chromium_fallback_digest,
            fallback_env = chromium_fallback_env,
            sidecar_service = "chromium-container",
            plugins = [
                volume_mount("/chromium-downloads", read_only = False),
            ],
            ports = {9222: "chromium"},
        ),
    )
