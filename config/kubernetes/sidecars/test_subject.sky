# DO NOT EDIT: http://go/vendor-skycfg
load("config/kubernetes/core/container.sky", "sidecar_container")
load("config/kubernetes/helpers/constants.sky", "GO_PROGRAMMING_LANGUAGE")
load("config/kubernetes/helpers/ldap.sky", "mount_ldap_host_volumes")
load("config/kubernetes/core/probe.sky", "http_probe", "probes")
load("config/kubernetes/plugins/compose.sky", "compose_plugins")
load("config/kubernetes/sidecars/variables.sky", "DEFUALT_CONTAINER_ENV", "TEST_SUBJECT_CONTAINER_FALLBACK_DIGEST")

def add_test_sidecar(ctx, port = 54321):
    sidecar_name = "henson-test-subject-sidecar"
    return compose_plugins(
        mount_ldap_host_volumes(container_name = sidecar_name),
        sidecar_container(
            sidecar_name,
            sidecar_service = sidecar_name,
            command = [
                "/sidecar",
                "-http-port",
                "{}".format(port),
            ],
            container_image = "stripe/henson-test-subject/sidecar",
            fallback_label = TEST_SUBJECT_CONTAINER_FALLBACK_DIGEST,
            fallback_env = DEFUALT_CONTAINER_ENV,
            plugins=[
                probes(
                    readiness=http_probe(
                        ctx,
                        path = "/healthcheck",
                        port = port,
                    ),
                ),
            ],
            programming_language = GO_PROGRAMMING_LANGUAGE,
        ),
    )
