                ),
            },
            rate_limiter_namespace_override = "monster-sigma-staging",
        ),
    ],
)

TEST_HOST_SET = struct(
    availability_tier = AVAILABILITY_TIER_A400,
    hostsets = [
        # We are explicitly setting the arm64 version of the image artifact (pay-server-image-noble-linux-arm64) for this deployment
        # but in practice it doesn't matter. If both pay-server-image-noble-linux-amd64 and pay-server-image-noble-linux-arm64 are
        # present in the deploy.yaml configuration for the service, Henson will create a multi-arch manifest combining both and
        # replace the container URI for both artifacts such that both point to the multi-arch definion.
        hostset(
            "monster-test",
            prod = {
                "northwest": cluster(consume_replicas = 2, fanout_replicas = 2, mb_per_worker = 2800, instance_type = r6g_4xlarge),
                "bom": cluster(mb_per_worker = 2800),
