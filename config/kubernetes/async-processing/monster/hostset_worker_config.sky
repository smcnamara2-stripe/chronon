                                end = "0 12 2 2 *",  # Scale down at 12:00 on the 2nd of February
                                desired_replicas = 31,
                                timezone = "UTC",
                            ),

                            # February (28 or 29 days)
                            schedule_trigger(
                                start = "0 12 21 2 *",  # Start scaling up at 12:00 on the 21st of February (7 days before end of month)
                                end = "0 12 2 3 *",  # Scale down at 12:00 on the 2nd of March
                                desired_replicas = 31,
                                timezone = "UTC",
                            ),

                            # March (31 days)
                            schedule_trigger(
                                start = "0 12 24 3 *",  # Start scaling up at 12:00 on the 24th of March (7 days before end of month)
                                end = "0 12 2 4 *",  # Scale down at 12:00 on the 2nd of April
                                desired_replicas = 31,
                                timezone = "UTC",
                            ),

                            # April (30 days)
                            schedule_trigger(
                                start = "0 12 23 4 *",  # Start scaling up at 12:00 on the 23rd of April (7 days before end of month)
                                end = "0 12 2 5 *",  # Scale down at 12:00 on the 2nd of May
                                desired_replicas = 31,
                                timezone = "UTC",
                            ),

                            # May (31 days)
                            schedule_trigger(
                                start = "0 12 24 5 *",  # Start scaling up at 12:00 on the 24th of May (7 days before end of month)
                                end = "0 12 2 6 *",  # Scale down at 12:00 on the 2nd of June
                                desired_replicas = 31,
                                timezone = "UTC",
                            ),

